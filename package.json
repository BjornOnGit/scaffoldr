{
  "name": "scaffoldr-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "turbo run build && vitest run",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "registry:build": "turbo run build --filter=@scaffoldr/registry-client && node scripts/build-registry.ts"
  },
  "dependencies": {
    "@scaffoldr/errors": "workspace:*",
    "@scaffoldr/registry-client": "workspace:*",
    "@scaffoldr/schema": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.10",
    "vitest": "^5.1.0"
  }
}
