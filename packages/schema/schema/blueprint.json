{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "pattern": "^[a-z0-9-]+$"
    },
    "defaults": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60,
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60,
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean"
          },
          "options": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60,
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "default": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "required": [
          "required",
          "options"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "select",
              "confirm"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "default": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "flag": {
            "type": "string",
            "pattern": "^--[a-z][a-z0-9-]*$"
          }
        },
        "required": [
          "id",
          "type",
          "flag"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "layer",
    "defaults",
    "slots",
    "questions"
  ],
  "additionalProperties": false
}
