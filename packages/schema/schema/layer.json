{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "engines": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "scaffoldr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "node",
        "scaffoldr"
      ],
      "additionalProperties": false
    },
    "injectionPoints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "packageJson": {
      "type": "object",
      "properties": {
        "scripts": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "devDependencies": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "peerDependencies": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": {}
    },
    "monorepo": {
      "type": "object",
      "properties": {
        "appDir": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "appDir"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "engines",
    "injectionPoints"
  ],
  "additionalProperties": false
}
